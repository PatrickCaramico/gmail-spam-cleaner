      "position": [
        470,
        300
      ],
      "credentials": {
        "googleGmailOAuth2Api": {}
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "trash",
        "messageId": "={{ $json.id }}"
      },
      "id": "f1e2d3c4-b5a6-4a5d-8e7f-1a2b3c4d5e6f",
      "name": "Deletar Mensagem",
