{
  "name": "Gmail Spam Cleaner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "limpar-spam",
        "options": {}
      },
      "id": "e7c1f8d9-2c3b-4a5d-8e7f-1a2b3c4d5e6f",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "gmail-spam-cleaner"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "s1c2h3e4-d5u6-4l7e-8t9r-1i2g3g4e5r6",
