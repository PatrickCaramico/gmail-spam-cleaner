      "position": [
        690,
        300
      ],
      "credentials": {
        "googleGmailOAuth2Api": {}
      }
    },
    {
      "parameters": {
        "mode": "wait"
      },
      "id": "c1d2e3f4-g5h6-4i7j-8k9l-1m2n3o4p5q6r",
      "name": "Aguardar Exclusão",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
